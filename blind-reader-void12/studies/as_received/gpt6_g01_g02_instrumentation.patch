diff --git a/blind-reader-void12/gap_instrumentation/validate_observations.py b/blind-reader-void12/gap_instrumentation/validate_observations.py
new file mode 100644
--- /dev/null
+++ b/blind-reader-void12/gap_instrumentation/validate_observations.py
@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+"""Structural validator for VOID-12 G01/G02 observations. No interpretation scoring."""
+import json
+import sys
+from pathlib import Path
+
+G01 = "G01_FIELD_ASSESSMENT"
+G02 = "G02_RECORD_BOUNDARY"
+VARIANTS = {"D0", "D1", "D2", "D3"}
+
+def validate_record(o, line_no=None):
+    errors = []
+    where = f"line {line_no}: " if line_no is not None else ""
+    required = ("schema_version", "experiment_id", "gap_id", "event_type",
+                "reader", "assignment", "source_snapshot", "term_id",
+                "observed_at", "payload")
+    for key in required:
+        if key not in o:
+            errors.append(where + f"missing {key}")
+    if errors:
+        return errors
+    if o["schema_version"] != "1.0":
+        errors.append(where + "unsupported schema_version")
+    if o["experiment_id"] != "VOID12-GAP-INSTRUMENTATION":
+        errors.append(where + "wrong experiment_id")
+    if o["gap_id"] not in ("G01", "G02"):
+        errors.append(where + "gap_id must be G01 or G02")
+        return errors
+    if o["term_id"] not in {f"T{i:02d}" for i in range(1, 16)}:
+        errors.append(where + "term_id must be T01 through T15")
+    reader = o["reader"]
+    for key in ("reader_id", "family", "session_id"):
+        if not isinstance(reader, dict) or not reader.get(key):
+            errors.append(where + f"reader.{key} is required")
+    a = o["assignment"]
+    if not isinstance(a, dict):
+        errors.append(where + "assignment must be an object")
+    else:
+        if a.get("mode") not in ("PARALLEL", "SEQUENTIAL"):
+            errors.append(where + "assignment.mode invalid")
+        if a.get("variant") not in VARIANTS:
+            errors.append(where + "assignment.variant invalid")
+        if not isinstance(a.get("sequence_index"), int) or a["sequence_index"] < 1:
+            errors.append(where + "assignment.sequence_index must be >= 1")
+        if a.get("mode") == "PARALLEL" and (a.get("sequence_index") != 1 or a.get("prior_variant") is not None):
+            errors.append(where + "parallel assignment must have sequence_index=1 and prior_variant=null")
+        if a.get("mode") == "SEQUENTIAL" and a.get("sequence_index", 1) > 1:
+            if a.get("prior_variant") not in VARIANTS:
+                errors.append(where + "sequential observation after first must name prior_variant")
+    snap = o["source_snapshot"]
+    if not isinstance(snap, dict) or snap.get("repository") != "JinnZ2/Simulators":
+        errors.append(where + "source_snapshot.repository must be JinnZ2/Simulators")
+    elif len(snap.get("commit", "")) != 40 or len(snap.get("packet_manifest_blob", "")) != 40:
+        errors.append(where + "source snapshot commit and packet_manifest_blob must be full 40-character Git IDs")
+    p = o["payload"]
+    if not isinstance(p, dict):
+        errors.append(where + "payload must be an object")
+        return errors
+    if o["gap_id"] == "G01":
+        if o["event_type"] != G01:
+            errors.append(where + "G01 requires event_type G01_FIELD_ASSESSMENT")
+        for k in ("field_assessments", "final_slots_specific", "ambiguity_detected", "alternatives_preserved"):
+            if k not in p:
+                errors.append(where + f"G01 payload missing {k}")
+        if isinstance(p.get("field_assessments"), list):
+            for i, f in enumerate(p["field_assessments"]):
+                prefix = where + f"field_assessments[{i}] "
+                for k in ("field_name", "origin", "instance_coverage", "tag_decision",
+                          "independence_decision", "included", "source_locations", "basis"):
+                    if k not in f:
+                        errors.append(prefix + f"missing {k}")
+                if f.get("origin") not in ("RAW_INPUT", "COMPUTED", "DECLARED_ONLY", "UNKNOWN"):
+                    errors.append(prefix + "invalid origin")
+                if f.get("tag_decision") not in ("YES", "NO", "UNRESOLVED"):
+                    errors.append(prefix + "invalid tag_decision")
+                if f.get("independence_decision") not in ("YES", "NO", "UNRESOLVED"):
+                    errors.append(prefix + "invalid independence_decision")
+                if f.get("included") is True and not (
+                    f.get("tag_decision") == "YES" and f.get("independence_decision") == "YES"
+                ):
+                    errors.append(prefix + "included=true requires TAG=YES and INDEPENDENCE=YES")
+    else:
+        if o["event_type"] != G02:
+            errors.append(where + "G02 requires event_type G02_RECORD_BOUNDARY")
+        for k in ("record_inventory", "stopping_rule", "selected_record_ids",
+                  "excluded_record_ids", "final_slots_carried", "nested_records_opened",
+                  "ambiguity_detected", "alternatives_preserved"):
+            if k not in p:
+                errors.append(where + f"G02 payload missing {k}")
+        selected = p.get("selected_record_ids", [])
+        excluded = p.get("excluded_record_ids", [])
+        if len(selected) != len(set(selected)):
+            errors.append(where + "selected_record_ids contains duplicates")
+        if len(excluded) != len(set(excluded)):
+            errors.append(where + "excluded_record_ids contains duplicates")
+        if set(selected) & set(excluded):
+            errors.append(where + "a record cannot be both selected and excluded")
+        if p.get("stopping_rule") not in (
+            "TERM_OWN_RECORD_ONLY", "ALL_REPORTING_PATH_RECORDS", "FIRST_WRAPPER_ONLY",
+            "NAME_NESTED_FIELD_DO_NOT_OPEN", "ALL_REACHABLE_RECORDS", "OTHER", "UNRESOLVED"
+        ):
+            errors.append(where + "invalid stopping_rule")
+    return errors
+
+def validate_jsonl(path):
+    all_errors = []
+    count = 0
+    with Path(path).open(encoding="utf-8") as fh:
+        for line_no, line in enumerate(fh, 1):
+            if not line.strip():
+                continue
+            count += 1
+            try:
+                obj = json.loads(line)
+            except json.JSONDecodeError as exc:
+                all_errors.append(f"line {line_no}: invalid JSON: {exc}")
+                continue
+            if not isinstance(obj, dict):
+                all_errors.append(f"line {line_no}: each line must be a JSON object")
+                continue
+            all_errors.extend(validate_record(obj, line_no))
+    return count, all_errors
+
+def main(argv=None):
+    argv = argv or sys.argv[1:]
+    if len(argv) != 1:
+        print("usage: python3 validate_observations.py observations.jsonl", file=sys.stderr)
+        return 2
+    count, errors = validate_jsonl(argv[0])
+    print(f"records: {count}")
+    print(f"structural_errors: {len(errors)}")
+    for error in errors:
+        print("- " + error)
+    return 1 if errors else 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
