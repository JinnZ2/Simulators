{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "reg-uncertainty-registry/registry.schema.json",
 "title": "Regulatory Uncertainty Registry (WO-REG-1 consolidated)",
 "description": "One file per object family under registry/. Enumerations live in vocabulary.json (x-vocab). tools/validate.py implements this subset of JSON Schema with the stdlib and refuses any keyword it does not implement.",
 "x-files": {
  "registry/sources.json": "SOURCE",
  "registry/evidence.json": "EVIDENCE",
  "registry/cases.json": "case",
  "registry/absences.json": "ENDPOINT_ABSENCE",
  "registry/outcomes.json": "OUTCOME",
  "registry/reversals.json": "REVERSAL",
  "registry/substances.json": "SUBSTANCE",
  "registry/endpoints.json": "ENDPOINT",
  "registry/actors.json": "ACTOR",
  "registry/authorities.json": "AUTHORITY",
  "registry/conflicts.json": "CONFLICT",
  "registry/ncr.json": "NCR",
  "registry/changes.json": "CHANGE",
  "registry/edges.json": "EDGE"
 },
 "x-edge-endpoints": {
  "_note": "allowed (from type, to type) per edge type; validate.py enforces",
  "cites": [["EVIDENCE", "SOURCE"], ["AUTHORITY", "SOURCE"], ["ENDPOINT_ABSENCE", "SOURCE"]],
  "supports": [["EVIDENCE", "DECISION"], ["EVIDENCE", "NON_DECISION"], ["EVIDENCE", "ENDPOINT_ABSENCE"], ["EVIDENCE", "NCR"], ["EVIDENCE", "CONFLICT"], ["EVIDENCE", "OUTCOME"], ["EVIDENCE", "REVERSAL"], ["EVIDENCE", "ACTOR"], ["EVIDENCE", "AUTHORITY"], ["EVIDENCE", "SUBSTANCE"], ["EVIDENCE", "ENDPOINT"]],
  "contradicts": [["EVIDENCE", "EVIDENCE"], ["EVIDENCE", "DECISION"], ["EVIDENCE", "NON_DECISION"], ["OUTCOME", "DECISION"], ["OUTCOME", "NON_DECISION"]],
  "supersedes": [["SOURCE", "SOURCE"], ["DECISION", "DECISION"], ["DECISION", "NON_DECISION"], ["OUTCOME", "DECISION"], ["OUTCOME", "NON_DECISION"]],
  "mirrors": [["DECISION", "DECISION"], ["DECISION", "NON_DECISION"], ["NON_DECISION", "DECISION"], ["NON_DECISION", "NON_DECISION"]],
  "forced_by": [["DECISION", "EVIDENCE"], ["NON_DECISION", "EVIDENCE"], ["DECISION", "AUTHORITY"], ["OUTCOME", "AUTHORITY"]],
  "predicts": [["EVIDENCE", "OUTCOME"], ["DECISION", "OUTCOME"]],
  "closes": [["OUTCOME", "DECISION"], ["OUTCOME", "NON_DECISION"], ["OUTCOME", "ENDPOINT_ABSENCE"], ["CHANGE", "NCR"]],
  "reverses": [["REVERSAL", "DECISION"], ["REVERSAL", "NON_DECISION"]],
  "decided_by": [["DECISION", "ACTOR"], ["NON_DECISION", "ACTOR"], ["OUTCOME", "ACTOR"]],
  "recommended_by": [["DECISION", "ACTOR"], ["NON_DECISION", "ACTOR"]],
  "overruled": [["DECISION", "ACTOR"], ["NON_DECISION", "ACTOR"]],
  "delegated_from": [["ACTOR", "ACTOR"]],
  "funded_by": [["ACTOR", "AUTHORITY"]],
  "authorized_by": [["DECISION", "AUTHORITY"], ["NON_DECISION", "AUTHORITY"]],
  "conflict_of": [["CONFLICT", "ACTOR"]],
  "concerns": [["CONFLICT", "DECISION"], ["CONFLICT", "NON_DECISION"], ["NCR", "DECISION"], ["NCR", "NON_DECISION"], ["NCR", "EVIDENCE"], ["NCR", "REVERSAL"], ["NCR", "SOURCE"], ["NCR", "ACTOR"]],
  "sponsored_by": [["DECISION", "ACTOR"], ["NON_DECISION", "ACTOR"]]
 },
 "$defs": {
  "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]*$"},
  "date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
  "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
  "history_entry": {"type": "object", "required": ["version", "value", "by"], "additionalProperties": false,
   "properties": {"version": {"type": "integer"}, "value": {}, "by": {"type": "string"}, "change": {"type": ["string", "null"]}}},
  "claim": {"type": "object", "required": ["value", "status", "coder"], "additionalProperties": false,
   "properties": {
    "value": {},
    "status": {"x-vocab": "claim_status"},
    "coder": {"type": "string"},
    "independence": {"x-vocab": "independence"},
    "basis": {"$ref": "#/$defs/ids"},
    "source": {"type": "string"},
    "rationale": {"type": "string"},
    "inference": {"type": "boolean"},
    "contested": {"type": "boolean"},
    "history": {"type": "array", "items": {"$ref": "#/$defs/history_entry"}}}},
  "verification": {"type": "object", "required": ["state", "depth", "reached", "queries", "exists", "says"], "additionalProperties": false,
   "properties": {
    "state": {"x-vocab": "verification_state"},
    "depth": {"x-vocab": "verification_depth"},
    "reached": {"enum": ["Y", "N", "?"]},
    "queries": {"type": "integer"},
    "exists": {"enum": ["Y", "N", "OTHER", "?"]},
    "says": {"enum": ["MATCH", "DIFFERS", "UNSEEN"]},
    "found": {"type": "string"},
    "corrected_value": {"type": ["string", "null"]},
    "ledger_row": {"type": ["string", "null"]},
    "reason": {"type": "string"},
    "checked": {"$ref": "#/$defs/date"}}},
  "side": {"type": "object", "required": ["P", "I", "D", "score", "grade", "rationale", "status", "coder"], "additionalProperties": false,
   "properties": {
    "P": {"type": ["integer", "null"]}, "I": {"type": ["integer", "null"]}, "D": {"type": ["integer", "null"]},
    "score": {"type": "integer"}, "grade": {"x-vocab": "rus_C"},
    "rationale": {"type": "string"}, "status": {"x-vocab": "claim_status"}, "coder": {"type": "string"},
    "axes_source": {"type": "string"}}},
  "consequence": {"type": "object", "required": ["C_permit", "C_restrict"], "additionalProperties": false,
   "properties": {
    "C_permit": {"$ref": "#/$defs/side"},
    "C_restrict": {"type": "object", "required": ["source", "registry", "substitution"], "additionalProperties": false,
     "properties": {
      "source": {"$ref": "#/$defs/side"},
      "registry": {"type": ["object", "null"]},
      "substitution": {"type": "object", "required": ["claimed", "named", "grade", "status"], "additionalProperties": false,
       "properties": {"claimed": {"type": "boolean"}, "named": {"type": ["string", "null"]}, "grade": {"type": ["string", "null"]},
        "status": {"x-vocab": "claim_status"}, "note": {"type": "string"}}}}}}},
  "grade_row": {"type": "object", "required": ["U", "cr_eff", "gap", "floor", "floor_rule", "actual", "deviation", "status"], "additionalProperties": false,
   "properties": {
    "U": {"x-vocab": "rus_U"}, "cr_eff": {"type": "integer"}, "gap": {"type": "integer"},
    "floor": {"x-vocab": "rus_D"}, "floor_rule": {"type": "string"}, "actual": {"x-vocab": "rus_D"},
    "deviation": {"type": "integer"}, "status": {"x-vocab": "rus02_status"},
    "substitution_rule": {"type": "string"}, "r6": {"x-vocab": "r6_state"}}},
  "case": {"type": "object", "required": ["id", "type", "title", "year", "agency", "frame", "in_sample", "claims", "authority_chain", "version"], "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "type": {"enum": ["DECISION", "NON_DECISION"]},
    "title": {"type": "string"},
    "year": {"type": "integer"},
    "agency": {"type": "string"},
    "frame": {"x-vocab": "frame"},
    "in_sample": {"type": "boolean"},
    "source_row": {"type": ["string", "null"]},
    "curation_key": {"type": "string"},
    "claims": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "consequence": {"$ref": "#/$defs/consequence"},
    "annex": {"type": "object"},
    "grades": {"type": "object", "additionalProperties": {"$ref": "#/$defs/grade_row"}},
    "exposure": {"type": "object", "required": ["axis", "values_in_sources"], "additionalProperties": false,
     "properties": {"axis": {"enum": ["rotation_pattern"]}, "values_in_sources": {"type": "array", "items": {"x-vocab": "rotation_pattern"}}, "note": {"type": "string"}}},
    "stages": {"type": "array"},
    "authority_chain": {"$ref": "#/$defs/ids"},
    "rigor_tier": {"x-vocab": "rigor_tier"},
    "single_failure": {"type": "array", "items": {"type": "string"}},
    "version": {"type": "integer"},
    "note": {"type": "string"}}},
  "SOURCE": {"type": "object", "required": ["id", "type", "cite", "kind", "verification"], "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["SOURCE"]}, "cite": {"type": "string"},
    "url": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]},
    "kind": {"x-vocab": "source_kind"}, "superseded": {"type": "boolean"},
    "rows": {"$ref": "#/$defs/ids"}, "verification": {"$ref": "#/$defs/verification"}}},
  "EVIDENCE": {"type": "object", "required": ["id", "type", "kind", "statement", "sources", "status", "verification"], "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["EVIDENCE"]}, "kind": {"x-vocab": "evidence_kind"},
    "statement": {"type": "string"}, "sources": {"$ref": "#/$defs/ids"}, "status": {"x-vocab": "claim_status"},
    "verification": {"$ref": "#/$defs/verification"},
    "rep": {"type": "string"}, "section": {"type": "string"},
    "located": {"type": "object"},
    "registry_value": {"type": ["string", "null"]},
    "evidence_class": {"type": "array", "items": {"x-vocab": "evidence_class"}},
    "rotation_pattern": {"x-vocab": "rotation_pattern"},
    "unlocated_reason": {"type": "string"},
    "note": {"type": "string"}}},
  "ENDPOINT_ABSENCE": {"type": "object", "required": ["id", "type", "substance", "endpoint", "state", "status", "corpus", "basis"], "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["ENDPOINT_ABSENCE"]}, "substance": {"type": "string"}, "endpoint": {"type": "string"},
    "state": {"x-vocab": "absence_state"}, "status": {"x-vocab": "claim_status"}, "corpus": {"type": "string"},
    "terms": {"type": "array", "items": {"type": "string"}}, "basis": {"$ref": "#/$defs/ids"},
    "decisions": {"$ref": "#/$defs/ids"}, "verification": {"$ref": "#/$defs/verification"}, "note": {"type": "string"}}},
  "OUTCOME": {"type": "object", "required": ["id", "type", "statement", "date", "kind", "direction", "basis", "status"], "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["OUTCOME"]}, "statement": {"type": "string"}, "date": {"$ref": "#/$defs/date"},
    "kind": {"enum": ["court", "legislature", "market_exit", "agency_followup", "proposal", "scheduled", "stay"]},
    "direction": {"x-vocab": "direction"}, "basis": {"$ref": "#/$defs/ids"}, "status": {"x-vocab": "claim_status"},
    "case": {"type": "string"}, "note": {"type": "string"}}},
  "REVERSAL": {"type": "object", "required": ["id", "type", "from_case", "to", "from_direction", "to_direction", "initiator", "initiator_type", "mechanism", "date_from", "date_to", "time_to_reversal_years", "harm_at_reversal", "status"], "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["REVERSAL"]},
    "from_case": {"type": "string"}, "to": {"type": "string"}, "to_case": {"type": ["string", "null"]},
    "from_direction": {"x-vocab": "reversal_direction"}, "to_direction": {"x-vocab": "reversal_direction"},
    "initiator": {"type": "string"}, "initiator_type": {"x-vocab": "initiator_type"}, "mechanism": {"x-vocab": "reversal_mechanism"},
    "date_from": {"$ref": "#/$defs/date"}, "date_to": {"$ref": "#/$defs/date"}, "date_basis": {"$ref": "#/$defs/ids"},
    "time_to_reversal_years": {"type": "number"},
    "harm_at_reversal": {"type": "object", "required": ["state"], "additionalProperties": false,
     "properties": {"state": {"x-vocab": "record_state"}, "value": {"type": ["string", "null"]}, "basis": {"$ref": "#/$defs/ids"}}},
    "alias_of": {"type": ["string", "null"]},
    "status": {"x-vocab": "claim_status"}, "coder": {"type": "string"}, "note": {"type": "string"}}},
  "SUBSTANCE": {"type": "object", "required": ["id", "type", "name", "ids", "id_state"], "additionalProperties": false,
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["SUBSTANCE"]}, "name": {"type": "string"},
    "ids": {"type": "object"}, "id_state": {"x-vocab": "id_state"}, "gap": {"type": "string"}, "basis": {"$ref": "#/$defs/ids"}}},
  "ENDPOINT": {"type": "object", "required": ["id", "type", "label", "ids", "id_state"], "additionalProperties": false,
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["ENDPOINT"]}, "label": {"type": "string"},
    "ids": {"type": "object"}, "id_state": {"x-vocab": "id_state"}, "gap": {"type": "string"}, "basis": {"$ref": "#/$defs/ids"}}},
  "ACTOR": {"type": "object", "required": ["id", "type", "actor_type", "name", "role_at_time", "date_range", "basis", "status"], "additionalProperties": false,
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["ACTOR"]}, "actor_type": {"x-vocab": "actor_type"},
    "name": {"type": "string"}, "role_at_time": {"type": "string"}, "date_range": {"type": "string"},
    "basis": {"$ref": "#/$defs/ids"}, "status": {"x-vocab": "claim_status"}}},
  "AUTHORITY": {"type": "object", "required": ["id", "type", "level", "citation", "verification"], "additionalProperties": false,
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["AUTHORITY"]}, "level": {"x-vocab": "authority_level"},
    "citation": {"type": "string"}, "title": {"type": "string"}, "verification": {"$ref": "#/$defs/verification"}, "note": {"type": "string"}}},
  "CONFLICT": {"type": "object", "required": ["id", "type", "actor_id", "conflict_type", "decision", "record_state", "statement", "basis", "status"], "additionalProperties": false,
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["CONFLICT"]}, "actor_id": {"type": "string"},
    "conflict_type": {"x-vocab": "conflict_type"}, "decision": {"type": "string"}, "record_state": {"x-vocab": "record_state"},
    "statement": {"type": "string"}, "recusal": {"enum": [true, false, null]}, "basis": {"$ref": "#/$defs/ids"},
    "status": {"x-vocab": "claim_status"}, "note": {"type": "string"}}},
  "NCR": {"type": "object", "required": ["id", "type", "origin", "ref", "finding", "item", "disposition", "reason", "changes", "originator", "adjudicator", "independence", "state", "rigor_tier", "single_failure"], "additionalProperties": false,
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["NCR"]}, "origin": {"x-vocab": "ncr_origin"}, "ref": {"type": "string"},
    "finding": {"type": "string"}, "item": {"type": "array", "items": {"type": "string"}}, "evidence": {"$ref": "#/$defs/ids"},
    "disposition": {"x-vocab": "ncr_disposition"}, "reason": {"type": "string"}, "changes": {"$ref": "#/$defs/ids"},
    "statements": {"$ref": "#/$defs/ids"},
    "originator": {"type": "string"}, "adjudicator": {"type": "string"}, "independence": {"x-vocab": "independence"},
    "state": {"x-vocab": "ncr_state"}, "rigor_tier": {"x-vocab": "rigor_tier"}, "single_failure": {"type": "boolean"},
    "note": {"type": ["string", "null"]}}},
  "CHANGE": {"type": "object", "required": ["id", "type", "seq", "date", "kind", "object", "field", "from", "to", "reason", "ncr", "wo", "author", "applied"], "additionalProperties": false,
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["CHANGE"]}, "seq": {"type": "integer"}, "date": {"$ref": "#/$defs/date"},
    "kind": {"x-vocab": "change_kind"}, "object": {"type": "string"}, "field": {"type": "string"},
    "from": {}, "to": {}, "reason": {"type": "string"}, "ncr": {"type": ["string", "null"]}, "wo": {"x-vocab": "wo"},
    "author": {"type": "string"}, "applied": {"type": "string"}}},
  "EDGE": {"type": "object", "required": ["from", "to", "type", "status"], "additionalProperties": false,
   "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "type": {"x-vocab": "edge_types"},
    "status": {"x-vocab": "claim_status"}, "basis": {"$ref": "#/$defs/ids"}, "kind": {"type": "string"}, "order": {"type": "integer"}, "note": {"type": "string"}}}
 }
}
