{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "reg-uncertainty-registry/schema/registry.schema.json",
 "title": "Regulatory Uncertainty Registry, pilot (WO-REG-1, WO-REG-1a)",
 "description": "One $defs entry per object type. x-vocab names a list in vocabulary.json; tools/reglib.py implements the subset of JSON Schema used here (type, required, properties, additionalProperties, items, enum, pattern, minItems, $ref) plus x-vocab. Semantic rules that a schema cannot state (claim status requirements, edge endpoint types, change coverage, pins) are in tools/validate.py.",
 "$defs": {
  "id": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_.-]*$"},
  "date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
  "history_entry": {"type": "object", "required": ["version", "value", "by"],
   "properties": {"version": {"type": "integer"}, "value": {}, "by": {"type": "string"}, "change": {"type": ["string", "null"]}},
   "additionalProperties": false},
  "claim": {"type": "object", "required": ["value", "status"],
   "properties": {
    "value": {},
    "status": {"x-vocab": "claim_status"},
    "basis": {"type": "array", "items": {"type": "string"}},
    "coder": {"type": "string"},
    "independence": {"x-vocab": "independence"},
    "derived_by": {"type": "string"},
    "rationale": {"type": "string"},
    "inference": {"type": "boolean"},
    "contested": {"type": "boolean"},
    "alternatives": {"type": "array"},
    "history": {"type": "array", "items": {"$ref": "#/$defs/history_entry"}}},
   "additionalProperties": false},
  "verification": {"type": "object", "required": ["state", "depth", "reached", "queries", "exists", "says"],
   "properties": {
    "state": {"x-vocab": "verification_state"},
    "depth": {"x-vocab": "verification_depth"},
    "reached": {"enum": ["Y", "N", "?"]},
    "queries": {"type": "integer"},
    "exists": {"enum": ["Y", "N", "OTHER", "?"]},
    "says": {"enum": ["MATCH", "DIFFERS", "UNSEEN"]},
    "found": {"type": "string"},
    "corrected_value": {"type": ["string", "null"]},
    "ledger_row": {"type": "string"},
    "checked": {"$ref": "#/$defs/date"}},
   "additionalProperties": false},
  "SOURCE": {"type": "object", "required": ["id", "type", "cite", "url", "kind", "verification", "rows"],
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["SOURCE"]},
    "cite": {"type": "string"}, "url": {"type": ["string", "null"]},
    "kind": {"enum": ["primary_record", "peer_reviewed", "agency_page", "court", "law_firm", "news", "secondary", "standard", "blog", "none_given"]},
    "cited_in": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "items": {"type": "string"}},
    "verification": {"$ref": "#/$defs/verification"},
    "aggregate_rule": {"type": "string"}},
   "additionalProperties": false},
  "EVIDENCE": {"type": "object", "required": ["id", "type", "kind", "statement", "sources", "status", "verification"],
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["EVIDENCE"]},
    "kind": {"x-vocab": "evidence_kind"},
    "statement": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "status": {"x-vocab": "claim_status"},
    "verification": {"$ref": "#/$defs/verification"},
    "evidence_class": {"type": "array", "items": {"x-vocab": "evidence_class"}},
    "forcing_kind": {"x-vocab": "forcing_kind"},
    "exposure": {"type": "object", "properties": {"metric": {"type": "string"}, "rotation_pattern": {"x-vocab": "rotation_pattern"}}, "additionalProperties": false},
    "unlocated_reason": {"type": "string"},
    "date": {"$ref": "#/$defs/date"},
    "note": {"type": "string"}},
   "additionalProperties": false},
  "rus01": {"type": "object", "required": ["U", "P", "I", "D", "C", "required", "actual", "status"],
   "properties": {"U": {"x-vocab": "rus_U"}, "P": {"type": "integer"}, "I": {"type": "integer"}, "D": {"type": "integer"}, "C": {"x-vocab": "rus_C"},
    "required": {"type": "string"}, "actual": {"type": "string"}, "status": {"type": "string"}, "rationale": {"type": "string"}},
   "additionalProperties": false},
  "rus02": {"type": "object", "required": ["U", "C_permit", "C_restrict", "Pr", "Ir", "Dr", "floor", "ceiling", "actual", "status", "variants"],
   "properties": {"U": {"x-vocab": "rus_U"}, "C_permit": {"x-vocab": "rus_C"}, "C_restrict": {"x-vocab": "rus_C"},
    "Pr": {"type": "integer"}, "Ir": {"type": "integer"}, "Dr": {"type": "integer"},
    "r1": {"enum": ["R1a", "R1b", "none"]}, "r5": {"type": "boolean"},
    "floor": {"x-vocab": "rus_D"}, "ceiling": {"x-vocab": "rus_D"}, "actual": {"x-vocab": "rus_D"},
    "status": {"x-vocab": "rus02_status"}, "variants": {"type": "object"}, "derived_by": {"type": "string"}},
   "additionalProperties": false},
  "case": {"type": "object", "required": ["id", "type", "title", "year", "agency", "arm", "in_sample", "claims", "authority_chain"],
   "properties": {
    "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["DECISION", "NON_DECISION"]},
    "title": {"type": "string"}, "year": {"type": "integer"}, "agency": {"x-vocab": "agency"}, "arm": {"x-vocab": "arm"},
    "jurisdiction": {"type": "string"},
    "in_sample": {"type": "boolean"},
    "source_row": {"type": ["string", "null"]},
    "source_flag": {"enum": ["S", "K", null]},
    "claims": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "rus01_source": {"$ref": "#/$defs/rus01"},
    "rus01_recomputed": {"$ref": "#/$defs/rus01"},
    "rus02": {"$ref": "#/$defs/rus02"},
    "authority_chain": {"type": "array", "items": {"type": "string"}},
    "rigor_tier": {"x-vocab": "rigor_tier"},
    "version": {"type": "integer"},
    "note": {"type": "string"}},
   "additionalProperties": false},
  "ENDPOINT_ABSENCE": {"type": "object", "required": ["id", "type", "substance", "endpoint", "state", "status", "corpus", "basis"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["ENDPOINT_ABSENCE"]}, "substance": {"type": "string"}, "endpoint": {"type": "string"},
    "state": {"x-vocab": "absence_state"}, "status": {"x-vocab": "claim_status"}, "as_of": {"$ref": "#/$defs/date"},
    "corpus": {"type": "string"}, "terms": {"type": "array", "items": {"type": "string"}}, "basis": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}},
   "additionalProperties": false},
  "OUTCOME": {"type": "object", "required": ["id", "type", "statement", "date", "kind", "basis", "status"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["OUTCOME"]}, "statement": {"type": "string"}, "date": {"$ref": "#/$defs/date"},
    "kind": {"enum": ["court", "legislature", "market_exit", "agency_followup", "proposal", "scheduled", "stay"]},
    "direction": {"x-vocab": "direction"}, "basis": {"type": "array", "items": {"type": "string"}}, "status": {"x-vocab": "claim_status"}, "note": {"type": "string"}},
   "additionalProperties": false},
  "SUBSTANCE": {"type": "object", "required": ["id", "type", "name", "kind", "ids", "id_state"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["SUBSTANCE"]}, "name": {"type": "string"},
    "kind": {"enum": ["chemical", "drug", "biologic", "device_material", "mixture", "plant_material", "exposure_circumstance", "class"]},
    "ids": {"type": "object"}, "id_state": {"enum": ["EXTERNAL_VERIFIED", "EXTERNAL_UNVERIFIED", "LOCAL_ONLY"]}, "gap": {"type": "string"}, "basis": {"type": "array", "items": {"type": "string"}}},
   "additionalProperties": false},
  "ENDPOINT": {"type": "object", "required": ["id", "type", "label", "ids", "id_state"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["ENDPOINT"]}, "label": {"type": "string"},
    "ids": {"type": "object"}, "id_state": {"enum": ["EXTERNAL_VERIFIED", "EXTERNAL_UNVERIFIED", "LOCAL_ONLY"]}, "gap": {"type": "string"}, "basis": {"type": "array", "items": {"type": "string"}}},
   "additionalProperties": false},
  "ACTOR": {"type": "object", "required": ["id", "type", "actor_type", "name", "role_at_time", "date_range", "basis"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["ACTOR"]}, "actor_type": {"x-vocab": "actor_type"}, "name": {"type": "string"},
    "role_at_time": {"type": "string"}, "date_range": {"type": "string"}, "basis": {"type": "array", "items": {"type": "string"}}, "status": {"x-vocab": "claim_status"}},
   "additionalProperties": false},
  "AUTHORITY": {"type": "object", "required": ["id", "type", "level", "citation", "verification"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["AUTHORITY"]}, "level": {"x-vocab": "authority_level"}, "citation": {"type": "string"},
    "title": {"type": "string"}, "verification": {"$ref": "#/$defs/verification"}, "note": {"type": "string"}},
   "additionalProperties": false},
  "CONFLICT": {"type": "object", "required": ["id", "type", "actor_id", "conflict_type", "decision", "record_state", "statement", "basis"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["CONFLICT"]}, "actor_id": {"type": "string"}, "conflict_type": {"x-vocab": "conflict_type"},
    "decision": {"type": "string"}, "record_state": {"x-vocab": "record_state"}, "statement": {"type": "string"}, "recusal": {"enum": [true, false, null]},
    "basis": {"type": "array", "items": {"type": "string"}}, "status": {"x-vocab": "claim_status"}, "note": {"type": "string"}},
   "additionalProperties": false},
  "FINDING": {"type": "object", "required": ["id", "type", "branch", "statement", "status", "quantity", "basis"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["FINDING"]}, "branch": {"x-vocab": "branch"}, "statement": {"type": "string"},
    "status": {"x-vocab": "claim_status"}, "quantity": {"type": ["string", "null"]}, "basis": {"type": "array", "items": {"type": "string"}},
    "inference": {"type": "boolean"}, "single_failure": {"type": "array"}, "replaces": {"type": ["string", "null"]}},
   "additionalProperties": false},
  "NCR": {"type": "object", "required": ["id", "type", "origin", "ref", "finding", "item", "disposition", "reason", "changes", "originator", "adjudicator", "independence", "state"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["NCR"]}, "origin": {"x-vocab": "ncr_origin"}, "ref": {"type": "string"},
    "finding": {"type": "string"}, "item": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}},
    "disposition": {"x-vocab": "ncr_disposition"}, "reason": {"type": "string"}, "changes": {"type": "array", "items": {"type": "string"}},
    "originator": {"type": "string"}, "adjudicator": {"type": "string"}, "independence": {"x-vocab": "independence"},
    "state": {"enum": ["OPEN", "CLOSED"]}, "rigor_tier": {"x-vocab": "rigor_tier"}, "note": {"type": "string"}},
   "additionalProperties": false},
  "CHANGE": {"type": "object", "required": ["id", "type", "date", "kind", "object", "field", "from", "to", "reason", "ncr", "wo", "author"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["CHANGE"]}, "date": {"$ref": "#/$defs/date"}, "kind": {"x-vocab": "change_kind"},
    "object": {"type": "string"}, "field": {"type": "string"}, "from": {}, "to": {}, "reason": {"type": "string"},
    "ncr": {"type": ["string", "null"]}, "wo": {"enum": ["WO-REG-1", "WO-REG-1a"]}, "author": {"type": "string"}},
   "additionalProperties": false},
  "EDGE": {"type": "object", "required": ["from", "to", "type", "status"],
   "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "type": {"x-vocab": "edge_types"}, "status": {"x-vocab": "claim_status"},
    "basis": {"type": "array", "items": {"type": "string"}}, "kind": {"type": "string"}, "note": {"type": "string"}},
   "additionalProperties": false}
 },
 "x-edge-endpoints": {
  "_note": "allowed (from type, to type) per edge; validate.py enforces",
  "cites": [["EVIDENCE", "SOURCE"], ["AUTHORITY", "SOURCE"], ["FINDING", "SOURCE"]],
  "supports": [["EVIDENCE", "DECISION"], ["EVIDENCE", "NON_DECISION"], ["EVIDENCE", "FINDING"], ["EVIDENCE", "ENDPOINT_ABSENCE"], ["EVIDENCE", "NCR"], ["EVIDENCE", "CONFLICT"], ["EVIDENCE", "OUTCOME"]],
  "contradicts": [["EVIDENCE", "DECISION"], ["EVIDENCE", "NON_DECISION"], ["EVIDENCE", "FINDING"], ["OUTCOME", "DECISION"], ["OUTCOME", "NON_DECISION"], ["EVIDENCE", "EVIDENCE"]],
  "supersedes": [["OUTCOME", "DECISION"], ["OUTCOME", "NON_DECISION"], ["DECISION", "DECISION"], ["DECISION", "NON_DECISION"], ["FINDING", "FINDING"], ["CHANGE", "CHANGE"]],
  "mirrors": [["DECISION", "DECISION"], ["DECISION", "NON_DECISION"], ["NON_DECISION", "DECISION"], ["NON_DECISION", "NON_DECISION"]],
  "forced_by": [["DECISION", "EVIDENCE"], ["NON_DECISION", "EVIDENCE"], ["DECISION", "AUTHORITY"], ["OUTCOME", "AUTHORITY"]],
  "predicts": [["DECISION", "OUTCOME"], ["NON_DECISION", "OUTCOME"], ["FINDING", "OUTCOME"], ["EVIDENCE", "OUTCOME"]],
  "closes": [["OUTCOME", "DECISION"], ["OUTCOME", "NON_DECISION"], ["CHANGE", "NCR"], ["OUTCOME", "ENDPOINT_ABSENCE"]],
  "decided_by": [["DECISION", "ACTOR"], ["NON_DECISION", "ACTOR"], ["OUTCOME", "ACTOR"]],
  "recommended_by": [["DECISION", "ACTOR"], ["NON_DECISION", "ACTOR"]],
  "overruled": [["DECISION", "ACTOR"], ["NON_DECISION", "ACTOR"]],
  "delegated_from": [["ACTOR", "ACTOR"]],
  "funded_by": [["ACTOR", "AUTHORITY"], ["ACTOR", "ACTOR"]],
  "authorized_by": [["DECISION", "AUTHORITY"], ["NON_DECISION", "AUTHORITY"], ["AUTHORITY", "AUTHORITY"]],
  "conflict_of": [["CONFLICT", "ACTOR"]],
  "recused_from": [["ACTOR", "DECISION"], ["ACTOR", "NON_DECISION"]],
  "concerns": [["DECISION", "SUBSTANCE"], ["NON_DECISION", "SUBSTANCE"], ["EVIDENCE", "ENDPOINT"], ["EVIDENCE", "SUBSTANCE"], ["ENDPOINT_ABSENCE", "SUBSTANCE"], ["ENDPOINT_ABSENCE", "ENDPOINT"], ["DECISION", "ENDPOINT"], ["NON_DECISION", "ENDPOINT"]]
 },
 "x-files": {
  "registry/sources.json": "SOURCE", "registry/evidence.json": "EVIDENCE", "registry/cases.json": "case",
  "registry/endpoint_absences.json": "ENDPOINT_ABSENCE", "registry/outcomes.json": "OUTCOME", "registry/substances.json": "SUBSTANCE",
  "registry/endpoints.json": "ENDPOINT", "registry/actors.json": "ACTOR", "registry/authorities.json": "AUTHORITY",
  "registry/conflicts.json": "CONFLICT", "registry/findings.json": "FINDING", "registry/ncr.json": "NCR",
  "registry/changes.json": "CHANGE", "registry/edges.json": "EDGE"
 }
}
